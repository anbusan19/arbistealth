# Deployer key and RPC
PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC=

# Canonical, already-deployed external registries for the target chain.
# Verify these on the chain's block explorer before deploying — do not
# assume addresses are identical across chains.
ERC5564_ANNOUNCER=
ERC6538_REGISTRY=

# Paxos USDG — set as FeeVault's preferred fee settlement asset.
# Verify the address for the target chain before deploying.
USDG_TOKEN=

# No ERC8004_* vars: the canonical ERC-8004 registries are still an actively
# evolving draft standard, so Deploy.s.sol deploys ArbiStealth's own
# SimpleAgent*Registry contracts instead. See their NatSpec and Deploy.s.sol's
# doc comment for why, and the migration path once the standard stabilizes.
